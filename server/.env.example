# Server environment variables
# Copy this file to .env and fill in your values

PORT=5000
NODE_ENV=development

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bug_tracker
DB_USER=postgres
DB_PASSWORD=postgres

# JWT Secret - use a long random string in production
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Client URL for CORS
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://neondb_owner:YOUR_ACTUAL_PASSWORD@ep-damp-silence-a1sdpd3c.ap-southeast-1.aws.neon.tech/neondb?sslmode=require